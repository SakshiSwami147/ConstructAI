# Copy this file to .env (never commit .env).

# pytesseract needs the Tesseract program. If tesseract.exe is not on PATH,
# give its full path here (Windows default shown):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# OCR language pack(s), e.g. eng or eng+hin
CONSTRUCTAI_OCR_LANG=eng
# Text orientations to read (0 = horizontal, 90/270 = vertical text)
CONSTRUCTAI_OCR_ROTATIONS=0,90,270
# INFO logs upload, preprocessing, Tesseract path, raw OCR text, parsed values, scale
CONSTRUCTAI_LOG_LEVEL=INFO
